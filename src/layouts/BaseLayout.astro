---
import '@198x-ui/tokens.css';
import '@198x-ui/fonts.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Debug198x',
  description = "One debug format, every 198x tool. Debug198x is the shared debug-information format that the assembler emits and the emulator reads.",
} = Astro.props;

const pageTitle = title === 'Debug198x' ? title : `${title} - Debug198x`;
---

<!doctype html>
<!-- data-tint carries the project colour as an ambient ground, at the ceilings
     fixed in the kit's tokens.css. See family-visual-identity.md §3b. -->
<html lang="en" data-tint="debug">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
